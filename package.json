{
  "name": "base44-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "20.17.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pdf": "vitest run --config vitest.foundation.config.js lambda/pdf-generator/__tests__/handler.test.mjs tooling/verify_pdf_bundle.test.mjs tooling/verify_pdf_parity.test.mjs",
    "verify:pdf-bundle": "node tooling/verify_pdf_bundle.mjs",
    "verify:pdf-parity": "node tooling/verify_pdf_parity.mjs",
    "sst:install": "sst install --stage test",
    "sst:diff:test": "sst diff --stage test --print-logs",
    "verify:file-cutover:test": "node tooling/verify_private_file_cutover.mjs --mode require --stage test",
    "sst:deploy:test": "npm run verify:file-cutover:test && sst deploy --stage test --print-logs && node tooling/configure_cognito_refresh_rotation.mjs --stage test --outputs .sst/outputs.json",
    "test:foundation": "vitest run --config vitest.foundation.config.js",
    "typecheck:foundation": "tsc -p ./tsconfig.foundation.json",
    "lint:foundation": "eslint sst.config.ts infra/sst backend/api lambda/pdf-generator/index.mjs lambda/pdf-generator/__tests__ tooling/verify_sst_foundation.mjs tooling/verify_private_file_cutover.mjs tooling/configure_cognito_refresh_rotation.mjs tooling/verify_pdf_bundle.mjs tooling/verify_pdf_bundle.test.mjs tooling/verify_pdf_parity.mjs tooling/verify_pdf_parity.test.mjs --quiet --no-error-on-unmatched-pattern"
  },
