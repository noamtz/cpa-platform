{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals", "aws-lambda"]
  },
  "include": [
    "sst.config.ts",
    "sst-env.d.ts",
    "infra/sst/**/*.ts",
    "backend/api/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", ".sst"]
}
