# Local SST commands must set an explicit named stage and AWS profile.
AWS_REGION=il-central-1
VITE_API_BASE_URL=/api
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_CALLBACK_URL=http://localhost:5173/auth/callback
VITE_COGNITO_LOGOUT_URL=http://localhost:5173/

# Required only for `sst diff --stage production`; keep real values in an
# ignored `.env.production.local` file or operator environment.
AUDITFLOW_BUDGET_ALERT_EMAIL=
AUDITFLOW_MONTHLY_BUDGET_USD=
AUDITFLOW_ILS_PER_USD=
