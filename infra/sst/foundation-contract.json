{
  "schemaVersion": 2,
  "app": "auditflow",
  "sstVersion": "3.19.3",
  "region": "il-central-1",
  "stages": ["test", "production"],
  "tables": [
    { "logicalName": "ClientTable", "primaryIndex": { "hashKey": "id" }, "globalIndexes": { "byCreatedDate": { "hashKey": "record_type", "rangeKey": "created_date" } } },
    { "logicalName": "SubmissionTable", "primaryIndex": { "hashKey": "id" }, "globalIndexes": { "byClientYear": { "hashKey": "client_id", "rangeKey": "tax_year" }, "byCreatedDate": { "hashKey": "record_type", "rangeKey": "created_date" } } },
    { "logicalName": "QuestionnaireTemplateTable", "primaryIndex": { "hashKey": "id" }, "globalIndexes": { "byVersion": { "hashKey": "record_type", "rangeKey": "version" } } },
    { "logicalName": "PdfTemplateTable", "primaryIndex": { "hashKey": "id" }, "globalIndexes": { "byCreatedDate": { "hashKey": "record_type", "rangeKey": "created_date" } } },
    { "logicalName": "SyncedDriveFileTable", "primaryIndex": { "hashKey": "id" }, "globalIndexes": { "bySubmission": { "hashKey": "submission_id", "rangeKey": "created_date" } } },
    { "logicalName": "UserTable", "primaryIndex": { "hashKey": "id" }, "globalIndexes": { "byCognitoSubject": { "hashKey": "cognito_sub" }, "byCreatedDate": { "hashKey": "record_type", "rangeKey": "created_date" } } },
    { "logicalName": "ChangeJournalTable", "primaryIndex": { "hashKey": "scope", "rangeKey": "sequence" }, "globalIndexes": { "byEntity": { "hashKey": "entity_key", "rangeKey": "sequence" } } }
  ],
  "buckets": [
    { "logicalName": "FilesBucket", "private": true, "cors": false, "versioning": true },
    { "logicalName": "TemporaryOutputsBucket", "private": true, "cors": false, "versioning": false, "expirationDays": 1 }
  ],
  "routes": [
    { "route": "GET /health", "authorization": "none" },
    { "route": "GET /auth/health", "authorization": "cognito-jwt" },
    { "route": "POST /cpa/clients/query", "authorization": "cognito-jwt", "authorizationScopes": ["auditflow-api/cpa"] },
    { "route": "POST /cpa/clients", "authorization": "cognito-jwt", "authorizationScopes": ["auditflow-api/cpa"] },
    { "route": "PATCH /cpa/clients/{id}", "authorization": "cognito-jwt", "authorizationScopes": ["auditflow-api/cpa"] },
    { "route": "POST /cpa/clients/{id}/token-rotation", "authorization": "cognito-jwt", "authorizationScopes": ["auditflow-api/cpa"] },
    { "route": "POST /cpa/submissions/query", "authorization": "cognito-jwt", "authorizationScopes": ["auditflow-api/cpa"] },
    { "route": "PATCH /cpa/submissions/{id}", "authorization": "cognito-jwt", "authorizationScopes": ["auditflow-api/cpa"] },
    { "route": "POST /cpa/users/query", "authorization": "cognito-jwt", "authorizationScopes": ["auditflow-api/cpa"] },
    { "route": "GET /cpa/me", "authorization": "cognito-jwt", "authorizationScopes": ["auditflow-api/cpa"] },
    { "route": "PATCH /cpa/me", "authorization": "cognito-jwt", "authorizationScopes": ["auditflow-api/cpa"] },
    { "route": "POST /cpa/users/invitations", "authorization": "cognito-jwt", "authorizationScopes": ["auditflow-api/cpa"] },
    { "route": "POST /cpa/integrations/google-drive/sync", "authorization": "cognito-jwt", "authorizationScopes": ["auditflow-api/cpa"] },
    { "route": "POST /cpa/integrations/google-drive/connect", "authorization": "cognito-jwt", "authorizationScopes": ["auditflow-api/cpa"] },
    { "route": "POST /cpa/integrations/google-drive/disconnect", "authorization": "cognito-jwt", "authorizationScopes": ["auditflow-api/cpa"] },
    { "route": "POST /cpa/integrations/telegram/notify", "authorization": "cognito-jwt", "authorizationScopes": ["auditflow-api/cpa"] }
  ],
  "auth": {
    "domainLogicalName": "UserPoolDomain",
    "resourceServerLogicalName": "CpaResourceServer",
    "resourceServerIdentifier": "auditflow-api",
    "scopeName": "cpa",
    "apiScope": "auditflow-api/cpa",
    "allowedOAuthFlows": ["code"],
    "allowedOAuthScopes": ["openid", "auditflow-api/cpa"],
    "callbackPath": "/auth/callback",
    "logoutPath": "/",
    "localOrigin": "http://localhost:5173",
    "clientSecret": false,
    "refreshTokenValidityDays": 30,
    "refreshTokenRotation": {
      "feature": "ENABLED",
      "retryGracePeriodSeconds": 10,
      "providerCompatibility": "post-deploy-sdk-update"
    }
  },
  "router": {
    "apiPrefix": "/api",
    "rewritePattern": "^/api/(.*)$",
    "rewriteReplacement": "/$1",
    "spaFallback": "index.html"
  },
  "oidc": {
    "providerUrl": "token.actions.githubusercontent.com",
    "audience": "sts.amazonaws.com",
    "subject": "repo:noamtz@2631641/cpa-platform@1332935468:environment:test"
  },
  "inventory": {
    "tables": 7,
    "buckets": 2,
    "routers": 1,
    "staticSites": 1,
    "apis": 1,
    "apiFunctions": 1,
    "userPools": 1,
    "userPoolClients": 1,
    "userPoolDomains": 1,
    "resourceServers": 1,
    "jwtAuthorizers": 1
  },
  "outputKeys": [
    "stage",
    "routerUrl",
    "siteUrl",
    "apiUrl",
    "apiId",
    "apiFunctionName",
    "routerDistributionId",
    "healthUrl",
    "protectedHealthUrl",
    "tableNames",
    "bucketNames",
    "userPoolId",
    "userPoolClientId",
    "authAuthority",
    "authCallbackUrl",
    "authLogoutUrl",
    "authScope",
    "testDeployRoleArn"
  ]
}
